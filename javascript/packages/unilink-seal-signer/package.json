{
  "name": "unilink-seal-signer",
  "version": "0.0.1",
  "type": "module",
  "description": "UniLink Seal signer (server-side) — signs URL-template payloads with Ed25519 over RFC 8785 canonicalized JSON.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "unilink-seal",
    "url",
    "template",
    "signature",
    "signer",
    "rfc-6570",
    "rfc-8785",
    "protocol"
  ],
  "license": "MIT",
  "author": "xesam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xesam/LinkSeal.git",
    "directory": "javascript/packages/unilink-seal-signer"
  },
  "homepage": "https://github.com/xesam/LinkSeal/tree/main/javascript/packages/unilink-seal-signer",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "unilink-seal": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
