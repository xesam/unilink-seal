{
  "name": "unilink-seal-crypto-minimal",
  "version": "0.1.0",
  "description": "Minimal zero-platform-dependency SignatureBackend for UniLink Seal — @noble/ed25519 + @noble/hashes, for environments without Web Crypto (e.g. mini-programs)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "dist/index.d.ts",
      "import": "dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0"
  },
  "peerDependencies": {
    "unilink-seal-resolver": "workspace:*"
  },
  "devDependencies": {
    "unilink-seal": "workspace:*",
    "unilink-seal-resolver": "workspace:*",
    "unilink-seal-signer": "workspace:*",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
