{
  "name": "linkseal-resolver",
  "version": "0.0.1",
  "type": "module",
  "description": "LinkSeal resolver (client-side) — verifies signatures, fills local variables, expands RFC 6570 templates to trusted URLs.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "linkseal",
    "url",
    "template",
    "signature",
    "resolver",
    "rfc-6570",
    "rfc-8785",
    "trust"
  ],
  "license": "MIT",
  "author": "xesam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xesam/LinkSeal.git",
    "directory": "javascript/packages/linkseal-resolver"
  },
  "homepage": "https://github.com/xesam/LinkSeal/tree/main/javascript/packages/linkseal-resolver",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "linkseal": "workspace:*"
  },
  "devDependencies": {
    "linkseal-signer": "workspace:*",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
